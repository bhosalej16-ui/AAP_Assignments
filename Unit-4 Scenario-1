import numpy as np
import pandas as pd

courses = ["Python", "Data Science", "AI", "Cloud Computing", "Cyber Security"]
fees = np.array([15000, 30000, 45000, 28000, 22000])

print("Average Course Fee:", np.mean(fees))
print("Maximum Course Fee:", np.max(fees))
print("Minimum Course Fee:", np.min(fees))

df = pd.DataFrame({
    "Course": courses,
    "Fee": fees
})

print("\nAll Courses:")
print(df)

print("\nCourses with Fees Greater than 25000:")
print(df[df["Fee"] > 25000])